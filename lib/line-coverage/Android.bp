package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Since we don't define UNITTEST_COVERAGE here, this library only provides
// stubs.
cc_library_host_static {
    name: "trusty_user_base_lib_line_coverage",
    srcs: [
        "shm.c",
    ],
    cflags: [
        "-Wno-unused-parameter",
    ],
    export_include_dirs: [
        "include",
    ],
    header_libs: [
        "external_trusty_lk_headers_uapi",
        "trusty_user_base_interface_coverage_headers",
        "trusty_user_base_interface_line_coverage_headers",
        "trusty_user_base_lib_libc_trusty_headers",
        "trusty_user_base_lib_tipc_headers",
    ],
    export_header_lib_headers: [
        "trusty_user_base_lib_tipc_headers",
    ],
    whole_static_libs: [
        "trusty_user_base_lib_coverage_common",
    ],
    export_static_lib_headers: [
        "trusty_user_base_lib_coverage_common",
    ],
}
