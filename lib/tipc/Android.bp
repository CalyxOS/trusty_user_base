package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_headers {
    name: "trusty_user_base_lib_tipc_headers",
    host_supported: true,
    export_include_dirs: [
        "include",
    ],
    header_libs: [
        "external_trusty_lk_headers_shared",
        "trusty_user_base_headers_user",
    ],
    export_header_lib_headers: [
        "external_trusty_lk_headers_shared",
        "trusty_user_base_headers_user",
    ],
}

// Provide a subset of lib/tipc based on unix domain sockets for host tests.
cc_library_host_static {
    name: "trusty_user_base_lib_tipc",
    srcs: [
        "tipc.c",
        "tipc_srv.c",
        "uds/handle_set_epoll.c",
        "uds/ipc_uds.c",
    ],
    whole_static_libs: [
        "trusty_user_base_lib_libc_trusty",
        "trusty_user_base_lib_line_coverage",
    ],
    header_libs: [
        "external_trusty_lk_headers_uapi",
        "trusty_kernel_headers_uapi",
        "trusty_user_base_interface_line_coverage_headers",
        "trusty_user_base_lib_tipc_headers",
    ],
    export_header_lib_headers: [
        "trusty_user_base_lib_tipc_headers",
    ],
}
