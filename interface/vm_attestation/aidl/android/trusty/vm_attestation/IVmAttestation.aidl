package android.trusty.vm_attestation;

/**
 * Interface for the Portable RKP Trusted App (TA).
 *
 * This interface bridges the OS (Host/Microdroid) and the RKP TA within Trusty.
 * It facilitates two primary flows:
 * 1. Generating key pairs for the RKP TA itself to be provisioned by the RKP server.
 * 2. Processing attestation requests from Client VMs, where the RKP TA acts as
 *    an intermediate minting authority.
 */
interface IVmAttestation {

    /**
     * A wrapper for a COSE_Mac0 structure containing a public key.
     *
     * This corresponds to the `MacedPublicKey` structure defined in the
     * IRemotelyProvisionedComponent HAL.
     */
    parcelable MacedPublicKey {
        /**
         * The COSE_Mac0 structure containing the public key.
         *
         * The payload is the COSE_Key representation of the public key.
         * The MAC tags the key to ensure it was generated by the secure environment.
         */
        byte[] macedPublicKey;
    }

    /**
     * A structure containing a generated key pair and its opaque reference.
     */
    parcelable RemotelyProvisionedKey {
        /**
         * The opaque handle to the private key.
         *
         * This blob is encrypted/wrapped by the Trusty TEE and cannot be used
         * or parsed by the client. It must be passed back to the TA during
         * attestation requests.
         */
        byte[] keyBlob;

        /**
         * The COSE_Mac0 structure containing the public key.
         *
         * This is verifiable by the provisioning server to ensure the key
         * was generated inside the TEE.
         */
        byte[] macedPublicKey;
    }

    /**
     * Generates a new ECDSA P-256 key pair that can be attested by the remote server.
     *
     * This key pair represents the identity of the RKP TA (or an intermediate key)
     * that will eventually sign the Client VM's attestation request.
     *
     * @return The generated key pair containing the private key handle (blob)
     *         and the COSE_Mac0 public key.
     * @throws ServiceSpecificException if key generation fails (e.g., RNG failure).
     */
    RemotelyProvisionedKey generateEcdsaP256KeyPair();

    /**
     * Creates a Certificate Signing Request (CSR) to be sent to the provisioning server.
     *
     * This method combines the generated public keys with a challenge from the
     * server to prove freshness.
     *
     * @param challenge A non-empty byte string (usually a nonce) from the
     *                  provisioning server to be included in the signed data.
     * @param keysToSign An array of MacedPublicKeys (COSE_Mac0) generated by
     *                   {@link #generateEcdsaP256KeyPair()}.
     *
     * @return The CBOR-encoded Certificate Signing Request (CSR).
     *         The structure matches the `CertificateRequest` CDDL definition in
     *         the RKP HAL.
     */
    byte[] generateCertificateRequest(
            in byte[] challenge,
            in MacedPublicKey[] keysToSign);

    /**
     * Requests an attestation certificate for a Client VM.
     *
     * In this operation, the RKP TA acts as a signing authority. It validates
     * the Client VM's DICE chain and CSR, then signs a new leaf certificate
     * using the RKP TA's own private key (passed in via `remotelyProvisionedKeyBlob`).
     *
     * @param csr The CBOR-encoded CSR from the Client VM.
     *            This must be signed by the Client VM's DICE Leaf Private Key.
     *            Format follows `client_vm_csr.cddl`.
     *
     * @param remotelyProvisionedKeyBlob The opaque key blob of the RKP TA's
     *                                   private key. This key must have been previously
     *                                   provisioned by the RKP server.
     *
     * @param remotelyProvisionedCert The DER-encoded X.509 leaf certificate
     *                                covering the public key corresponding to the
     *                                private key in `remotelyProvisionedKeyBlob`.
     *
     * @return A DER-encoded X.509 certificate covering the public key to be
     *         attested in the provided CSR. The certificate is signed by the
     *         remotely provisioned private key and also includes an extension
     *         that describes the attested client VM.
     *
     * @throws ServiceSpecificException on validation failure (e.g., DICE chain mismatch,
     *                                  security version rollback, or invalid CSR signature).
     */
    byte[] requestAttestation(
            in byte[] csr,
            in byte[] remotelyProvisionedKeyBlob,
            in byte[] remotelyProvisionedCert);
}
